# Copy this to .env and fill in real values. Never commit .env.

# === Server config ===
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# === Database ===
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/securereview?retryWrites=true&w=majority

# === Auth secrets ===
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# === GitHub OAuth (Phase 2) ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# === LLM API keys (Phase 5) ===
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === LLM config ===
PRIMARY_LLM=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
CLAUDE_MODEL=claude-sonnet-4-6

# === Agent config ===
MAX_AGENT_ITERATIONS=12
MAX_CONTEXT_CHUNKS=6
AGENT_TIMEOUT_MS=120000

# === Embedding config ===
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384

# === Storage ===
REPO_CLONE_DIR=./tmp/repos
