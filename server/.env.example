# Copy this file to .env and fill in real values. Never commit .env.

# === Server config ===
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# === Database ===
# MongoDB Atlas connection string (M0 free tier works).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/securereview?retryWrites=true&w=majority

# === Auth secrets ===
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64 hex bytes>
SESSION_SECRET=<64 hex bytes>

# === GitHub OAuth (dev) ===
# Register an OAuth App at https://github.com/settings/developers
# Homepage URL:  http://localhost:5173
# Callback URL:  http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# === LLM API keys (DEV SCRIPTS ONLY) ===
# These are read ONLY by local dev scripts (seedSecurityKB.js, testAgentLoop.js).
# In production / HTTP requests, the app is pure BYOK — each user supplies
# their own keys via /settings. Leave these blank in production.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === LLM config ===
PRIMARY_LLM=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
CLAUDE_MODEL=claude-sonnet-4-5
LLM_DISABLED_PROVIDERS=

# === Agent config ===
MAX_AGENT_ITERATIONS=12
MAX_CONTEXT_CHUNKS=6
AGENT_TIMEOUT_MS=600000

# === Embedding config ===
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# === Storage ===
REPO_CLONE_DIR=./tmp/repos
